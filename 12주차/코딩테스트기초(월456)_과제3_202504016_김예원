class Node:
    def __init__(self, value):
        self.value = value
        self.left = None  #왼쪽 자식 노드
        self.right = None #오른쪽 자식 노드

#오른쪽 서브트리에서 가장 작은 값을 가진 노드 찾기
def findSmallestNode(startNode):
    currentNode = startNode
    while currentNode.left is not None:
        currentNode = currentNode.left
    return currentNode

#이진 탐색 트리에서 값이 targetValue인 노드를 삭제하는 함수
def deleteNode(rootNode, targetValue):
    if rootNode is None:
        return rootNode  # 트리가 비었으면 종료

    #삭제할 값이 현재 노드 값보다 작으면 왼쪽 서브트리 탐색
    if targetValue < rootNode.value:
        rootNode.left = deleteNode(rootNode.left, targetValue)

    #삭제할 값이 현재 노드 값보다 크면 오른쪽 서브트리 탐색
    elif targetValue > rootNode.value:
        rootNode.right = deleteNode(rootNode.right, targetValue)

    #삭제할 노드를 찾았을 때
    else:
        #자식이 없는 경우 or 오른쪽 자식만 있는 경우
        if rootNode.left is None:
            tempNode = rootNode.right
            rootNode = None
            return tempNode

        #왼쪽 자식만 있는 경우
        elif rootNode.right is None:
            tempNode = rootNode.left
            rootNode = None
            return tempNode

        #자식이 둘 다 있는 경우
        #오른쪽 서브트리에서 가장 작은 값을 찾아서 현재 노드를 대체
        tempNode = findSmallestNode(rootNode.right)
        rootNode.value = tempNode.value  #값만 교체
        rootNode.right = deleteNode(rootNode.right, tempNode.value)  # 후속자 노드 삭제

    return rootNode

#트리를 중위 순회하면서 값 출력하기(확인용)
def printInOrder(node):
    if node:
        printInOrder(node.left)
        print(node.value, end=' ')
        printInOrder(node.right)


if __name__ == '__main__':
    #트리 만들기
    root = Node(60)
    root.left = Node(40)
    root.right = Node(85)
    root.left.left = Node(5)
    root.left.right = Node(50)
    root.left.right.left = Node(30)
    root.left.right.left.left = Node(10)

    print("삭제 전 트리(중위 순회):")
    printInOrder(root)
    print()

    #값 40 삭제하기
    root = deleteNode(root, 40)

    print("40 삭제 후 트리(중위 순회):")
    printInOrder(root)